{
  "name": "growth-records",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/sync-project-skill.mjs",
    "skill:sync": "node scripts/sync-project-skill.mjs",
    "skill:install": "node scripts/sync-project-skill.mjs --install",
    "skill:test": "node --test tests/skills/sync-project-skill.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write resources/js vite.config.js tsconfig.json"
  },
  "dependencies": {
    "element-plus": "^2.11.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
