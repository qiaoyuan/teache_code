# Example only: substitute the real domain, deployment path, FPM socket and TLS configuration.
server {
    listen 80;
    server_name example.com;
    root /var/www/shengxue360/public;
    index index.php;
    charset utf-8;
    client_max_body_size 2m;

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location /build/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
