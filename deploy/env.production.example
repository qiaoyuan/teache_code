# 首次部署复制到项目根目录 .env；升级时保留已有 .env 和 APP_KEY。
# 以下域名、数据库账号和密码必须按服务器替换，不能原样上线。
APP_NAME="成长档案"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shengxue360
DB_USERNAME=shengxue360
# 密码含 #、空格或 $ 等字符时使用单引号包裹，避免插值。
DB_PASSWORD='CHANGE_ME_DATABASE_PASSWORD'

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
BCRYPT_ROUNDS=12

ADMIN_USERNAME=admin
# 建议保持空白，首次运行 php artisan admin:init 时交互输入密码。
# 若自动化部署临时填写本项，初始化后清空并重新 config:cache。
ADMIN_PASSWORD=
